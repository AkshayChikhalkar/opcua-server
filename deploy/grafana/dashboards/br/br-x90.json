{
  "uid": "br-x90",
  "title": "B&R X90",
  "description": "Logbooks from the System Diagnostics Manager, and every PLC variable the X90 publishes over OPC UA.",
  "tags": ["br", "x90"],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 39,
  "editable": true,
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Logbooks",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 4},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "P40AE60E18F02DE32"},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "Offline", "color": "red"}, "1": {"text": "Live", "color": "green"}}}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none", "textMode": "value"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "P40AE60E18F02DE32"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN EXISTS (SELECT 1 FROM recorder_status rs JOIN controllers c ON c.id = rs.controller_id WHERE c.endpoint LIKE 'sdm://%' AND rs.listening AND rs.last_seen > now() - interval '45 seconds') THEN 1 ELSE 0 END AS \"Recorder\""
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Values",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 4},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "P40AE60E18F02DE32"},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "Offline", "color": "red"}, "1": {"text": "Live", "color": "green"}}}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background", "graphMode": "none", "textMode": "value"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "P40AE60E18F02DE32"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN EXISTS (SELECT 1 FROM recorder_status rs JOIN controllers c ON c.id = rs.controller_id WHERE c.name = 'B&R X90' AND c.endpoint LIKE 'opc.tcp://%' AND rs.listening AND rs.last_seen > now() - interval '45 seconds') THEN 1 ELSE 0 END AS \"Values\""
        }
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Bearing temp front",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "P40AE60E18F02DE32"},
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "min": 0,
          "max": 120,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 90}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "minVizWidth": 75,
        "minVizHeight": 75
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "P40AE60E18F02DE32"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT l.value_num AS \"Front\" FROM latest l JOIN signals s ON s.id = l.signal_id JOIN controllers c ON c.id = s.controller_id WHERE c.name = 'B&R X90' AND c.endpoint LIKE 'opc.tcp://%' AND s.identifier = '::IO_link_in:rLagertemp_Kreisel_front'"
        }
      ]
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Bearing temp rear",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "P40AE60E18F02DE32"},
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "min": 0,
          "max": 120,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 90}
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "minVizWidth": 75,
        "minVizHeight": 75
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "P40AE60E18F02DE32"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT l.value_num AS \"Rear\" FROM latest l JOIN signals s ON s.id = l.signal_id JOIN controllers c ON c.id = s.controller_id WHERE c.name = 'B&R X90' AND c.endpoint LIKE 'opc.tcp://%' AND s.identifier = '::IO_link_in:rLagertemp_Kreisel_rear'"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Bearing temperature",
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 8},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "P40AE60E18F02DE32"},
      "fieldConfig": {"defaults": {"unit": "celsius", "decimals": 1, "custom": {"drawStyle": "line", "lineWidth": 2, "spanNulls": true, "showPoints": "never"}}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "P40AE60E18F02DE32"},
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT sa.received_at AS \"time\", CASE s.identifier WHEN '::IO_link_in:rLagertemp_Kreisel_front' THEN 'Front' WHEN '::IO_link_in:rLagertemp_Kreisel_rear' THEN 'Rear' END AS metric, sa.value_num AS value FROM samples sa JOIN signals s ON s.id = sa.signal_id JOIN controllers c ON c.id = s.controller_id WHERE c.name = 'B&R X90' AND c.endpoint LIKE 'opc.tcp://%' AND s.identifier IN ('::IO_link_in:rLagertemp_Kreisel_front', '::IO_link_in:rLagertemp_Kreisel_rear') AND $__timeFilter(sa.received_at) ORDER BY 1"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Latest values",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 8},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "P40AE60E18F02DE32"},
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false, "reducer": ["sum"], "countRows": false}},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "P40AE60E18F02DE32"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.name AS \"Signal\", l.time AS \"Time\", l.value_num AS \"Value\", l.value_text AS \"Text\" FROM latest l JOIN signals s ON s.id = l.signal_id JOIN controllers c ON c.id = s.controller_id WHERE c.name = 'B&R X90' AND c.endpoint LIKE 'opc.tcp://%' ORDER BY s.name"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Logbook",
      "gridPos": {"x": 0, "y": 28, "w": 24, "h": 12},
      "datasource": {"type": "grafana-postgresql-datasource", "uid": "P40AE60E18F02DE32"},
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false, "reducer": ["sum"], "countRows": false}},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "grafana-postgresql-datasource", "uid": "P40AE60E18F02DE32"},
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sa.received_at AS \"time\", sa.time AS \"PLC time\", s.name AS \"Book\", sa.value_num AS \"Level\", sa.status AS \"Code\", sa.value_text AS \"Message\" FROM samples sa JOIN signals s ON s.id = sa.signal_id JOIN controllers c ON c.id = s.controller_id WHERE c.endpoint LIKE 'sdm://%' AND $__timeFilter(sa.received_at) ORDER BY sa.received_at DESC"
        }
      ]
    }
  ]
}
