{
  "uid": "safety-control-ecu",
  "title": "Safety Control ECU",
  "description": "History charts use the time a sample arrived. The controller clock runs ahead of the database, which had left those charts empty.",
  "tags": [
    "opcua",
    "ecu"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "schemaVersion": 39,
  "fiscalYearStartMonth": 0,
  "editable": true,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "panels": [
    {
      "id": 20,
      "type": "stat",
      "title": "Recorder",
      "description": "Live when a sample has arrived in the last 20 seconds, or the recorder heartbeat is fresh.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "P40AE60E18F02DE32"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Offline",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Live",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto",
        "text": {
          "titleSize": 14,
          "valueSize": 28
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P40AE60E18F02DE32"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN EXISTS (SELECT 1 FROM recorder_status WHERE controller_id = ${controller} AND listening AND last_seen > now() - interval '20 seconds') OR (SELECT max(sa.received_at) FROM samples sa JOIN signals s ON s.id = sa.signal_id WHERE s.controller_id = ${controller}) > now() - interval '20 seconds' THEN 1 ELSE 0 END AS \"Recorder\""
        }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Age",
      "description": "Seconds since a sample arrived in the database.",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
