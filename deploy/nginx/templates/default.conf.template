# ECU name → B&R web UI. ECU_NAME and BR_HOST are filled from the container env.
server {
    listen 80 default_server;
    server_name ${ECU_NAME} localhost 127.0.0.1 _;

    # Open the SDM home page when only the ECU name is typed.
    location = / {
        return 302 /sdm/;
    }

    location / {
        proxy_pass http://${BR_HOST};
        proxy_http_version 1.1;
        proxy_set_header Host ${BR_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }
}
